# Brewfile — managed by dotfiles
# Install everything: brew bundle
# Check everything: brew bundle check
# Cleanup unlisted packages: brew bundle cleanup

# Core
brew "git"
brew "stow"
brew "curl"
brew "wget"

# Shell
brew "zsh"
brew "starship"
brew "zoxide"
brew "fzf"
brew "direnv"

# Terminal tools
brew "fastfetch"
brew "bat"
brew "git-delta"
brew "neovim"
brew "lefthook"
brew "git-cliff"

# Linters / formatters
brew "shellcheck"
brew "shfmt"

# Credentials
cask "git-credential-manager"
