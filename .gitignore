# OS
.DS_Store

# Language / runtime artifacts
**/__pycache__/
**/*.pyc
**/node_modules/
**/logs/

# Shell runtime state
zsh/.config/zsh/sessions/
**/*history
**/*.session

# Machine-local overrides — not tracked in repo
*.local.*
shell/.config/shell/local.sh
git/.config/git/config.local

# Credential and secret files — never commit these
.env
.env.*
*.key
*.pem
*.p12
*.token
credentials.json
secrets.*
