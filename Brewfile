# Brewfile — managed by dotfiles
# Install everything: brew bundle
# Check everything: brew bundle check
# Cleanup unlisted packages: brew bundle cleanup

# Core
brew "git"
brew "stow"
brew "curl"
brew "wget"

# Shell
brew "zsh"
brew "starship"
brew "zoxide"
brew "fzf"
brew "direnv"
brew "zsh-completions"
brew "zsh-autosuggestions"
brew "zsh-fast-syntax-highlighting"

# Terminal tools
brew "fastfetch"
brew "bat"
brew "eza"
brew "ripgrep"
brew "fd"
brew "git-delta"
brew "neovim"
brew "lefthook"
brew "git-cliff"

# Linters / formatters
brew "shellcheck"
brew "shfmt"

# Credentials
on_macos do
  cask "git-credential-manager"
end
